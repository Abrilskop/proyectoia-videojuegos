# Token del bot (Discord Developer Portal -> Applications -> tu app -> Bot -> Reset Token)
DISCORD_TOKEN=

# ID de canal donde se reenvian mensajes en cola de revision humana (opcional)
REVIEW_CHANNEL_ID=

# ID de canal de auditoria/log de decisiones (opcional)
LOG_CHANNEL_ID=

# Canales a moderar separados por coma. Vacio = todos los canales del servidor.
MONITOR_CHANNEL_IDS=

# Timeout en segundos para usuarios con mensajes bloqueados
TIMEOUT_SECONDS=600

# Umbrales de toxicidad del sistema IA
UMBRAL_BLOQUEO=0.80
UMBRAL_REVISION=0.50
